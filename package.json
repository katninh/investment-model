    "next": "^15.5.25",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-apexcharts": "^2.1.1",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
